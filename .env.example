# 本机配置；pnpm run setup 会复制为 .env，不覆盖已有文件。
# 不要提交 .env、登录凭据、会话、截图和业务台账。
PORT=5199
DELIVERY_DATA_DIR=.data
DELIVERY_SOURCE_DATA_DIR=.data/source
DELIVERY_SKILLS_ROOT=./support/skills
AI_DELIVERY_KIT_ROOT=./support/ai-delivery-kit

# CLI 默认探测完整 Codex 桌面运行时和 PATH，不需要填写作者的路径。
# DELIVERY_CODEX_BIN=/absolute/path/to/codex
# DELIVERY_CURSOR_BIN=/absolute/path/to/cursor-agent
# CODEX_HOME=/absolute/path/to/your/.codex
# DELIVERY_GIT_BIN=git
# DELIVERY_CURSOR_EDITOR_BIN=cursor
# DELIVERY_TIME_ZONE=Asia/Shanghai

# 自己的项目根目录；多个目录用系统路径分隔符分开（macOS/Linux :）。
# LOCAL_PROJECT_ROOTS=/absolute/path/to/your/projects
# LOCAL_PROJECT_SCAN_DEPTH=6

# Jira 可选。使用你自己的站点和鉴权方式；不要填示例账号。
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
# 自动功能切片的项目允许列表，逗号分隔，例如 DEMO,TEAM；留空不自动创建或更新切片。
JIRA_AUTOMATION_PROJECT_KEYS=
# JIRA_AUTH_HEADER=Bearer ...
# JIRA_COOKIE=...
# JIRA_KEYCHAIN_SERVICE=your-existing-keychain-service
# JIRA_KEYCHAIN_ACCOUNT=your-account

# Confluence 可选；技术方案执行还需本机名为 atlassian 的 MCP。
CONFLUENCE_BASE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
# CONFLUENCE_AUTH_HEADER=Bearer ...
# CONFLUENCE_PAT=...

# 自动化首次默认暂停，在工作台设置页按项目配置并显式启用。
# DELIVERY_SCHEDULER_DISABLED=1
# DELIVERY_REPOSITORY_URL=https://github.com/your-account/your-project.git
# DELIVERY_TARGET_BRANCH=main
# DELIVERY_RUNTIME_ENVIRONMENT=development
# DELIVERY_RUNTIME_COMMAND=pnpm dev
# DELIVERY_REVIEWER=your-reviewer
# DELIVERY_LOGIN_KEYCHAIN_SERVICE=your-existing-keychain-service
# DELIVERY_LOGIN_KEYCHAIN_ACCOUNT=your-account

# 接口审核/联调：未配置时只显示未测试的中性示例。
# DELIVERY_INTEGRATION_PLAN_FILE=.data/integration-plan.json
# DELIVERY_INTERFACE_INVENTORY_FILE=.data/interface-inventory.json
# DELIVERY_REFACTOR_REPOSITORY=/absolute/path/to/your/refactor-project
# DELIVERY_INTEGRATION_CONFIG_FILE=.data/integration-execution-config.json
# DELIVERY_WECOM_CONFIG_FILE=.data/credentials/wecom-integration.json

# 需求追平/合入：默认空看板，载入你自己的 manifest、资料和计划。
# APEX_CATCHUP_DATA_ROOT=.data/source/catchup
# APEX_CATCHUP_DOCUMENTS_ROOT=.data/source/catchup/docs
# APEX_CATCHUP_SOURCE_REPOSITORY=/absolute/path/to/your/project
# APEX_CATCHUP_REQUIREMENTS_ROOT=.data/source/requirements
# APEX_CATCHUP_SESSIONS_ROOT=.data/source/sessions
# APEX_CATCHUP_RUNTIME_SUPPORT_SOURCE=/absolute/path/to/your/runtime-support
# APEX_CATCHUP_BASE_SHA=your-verified-base-ref
# APEX_CATCHUP_MERGE_PLAN_FILE=.data/source/catchup/merge-plan.json
# APEX_CATCHUP_SCOPE_FILE=.data/source/catchup/scope.json
# APEX_CATCHUP_MERGE_REPOSITORY=/absolute/path/to/your/project
# APEX_CATCHUP_MERGE_TARGET_BRANCH=main
# APEX_CATCHUP_GITLAB_PROJECT_URL=https://gitlab.example.com/group/project
# APEX_CATCHUP_MERGE_WORKSPACE=.data/source/workspaces/merge
APEX_CATCHUP_JIRA_DISABLED=1
# APEX_CATCHUP_JIRA_PARENT_KEY=DEMO-123
# APEX_CATCHUP_JIRA_PROJECT_KEY=DEMO
# APEX_CATCHUP_JIRA_SUBTASK_TYPE_ID=your-subtask-type-id
# APEX_CATCHUP_JIRA_ASSIGNEE=your-jira-account
# APEX_CATCHUP_JIRA_START_DATE=YYYY-MM-DD
# APEX_CATCHUP_JIRA_END_DATE=YYYY-MM-DD

# 例会快照筛选，可选。
# DELIVERY_MEETING_SNAPSHOT_FILE=.data/source/meeting-snapshot.json
# MEETING_ASSIGNEE_NAME=your-display-name
# MEETING_ASSIGNEE_USER_KEYS=your-jira-user-key
# MEETING_TITLE_PREFIX=your-team

# Mastra 实验室默认规则分析；按自己的供应商配置模型及密钥。
# DELIVERY_MODEL=provider/model

# 独立远程网关（可选，使用自己的 HTTPS 地址与账号）。
# DELIVERY_REMOTE_ORIGIN=https://workbench.example.com
# DELIVERY_REMOTE_USERNAME=your-account
# DELIVERY_REMOTE_CONFIG_DIR=/absolute/path/to/private-gateway-config
