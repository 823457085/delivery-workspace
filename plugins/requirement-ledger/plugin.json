{
  "apiVersion": 1,
  "hostApi": 1,
  "id": "requirement-ledger",
  "name": "轻量需求台账",
  "version": "1.1.0",
  "description": "面向日常迭代的需求拆解与验收标准台账，支持工时估算、PRD 链接、业务标签及关联/创建 Jira 单据。",
  "permissions": ["storage.read", "storage.write", "jira.read", "jira.create", "conversation.context"],
  "page": { "title": "轻量需求台账", "kind": "records" },
  "records": {
    "storage": "private",
    "resourceType": "requirement",
    "fields": [
      { "key": "title", "label": "需求标题", "type": "text", "required": true, "maxLength": 200 },
      { "key": "module", "label": "所属模块 / 仓库", "type": "text", "maxLength": 160 },
      { "key": "prdUrl", "label": "PRD / 原型链接", "type": "url", "maxLength": 500 },
      { "key": "estimateDays", "label": "预估工时（人日）", "type": "number", "maxLength": 20 },
      { "key": "targetDate", "label": "计划提测日期", "type": "date" },
      { "key": "status", "label": "推进状态", "type": "select", "default": "clarifying", "options": [
        { "value": "clarifying", "label": "待澄清" },
        { "value": "developing", "label": "开发中" },
        { "value": "testing", "label": "联调提测" },
        { "value": "released", "label": "已上线" }
      ] },
      { "key": "tags", "label": "业务标签", "type": "tags", "maxLength": 400 },
      { "key": "details", "label": "需求范围与验收标准", "type": "textarea", "maxLength": 8000 }
    ]
  },
  "commands": [
    { "id": "cite", "label": "带入 Agent 会话", "action": "conversation.context" },
    { "id": "link-jira", "label": "关联已有 Jira", "action": "jira.link" },
    { "id": "create-jira", "label": "生成 Jira 任务", "action": "jira.create" }
  ]
}
